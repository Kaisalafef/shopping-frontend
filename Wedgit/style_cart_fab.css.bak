/* ==========================================================================
   FLOATING CART BUTTON (FAB) — style_cart_fab.css
   A shared, self-contained widget. Load alongside style_header.css /
   style_footer.css on every client-facing page. Injected into the DOM by
   script_cart_fab.js, so no manual HTML markup is required per page.
   ========================================================================== */

:root {
    --fab-bg: #FF9700;
    --fab-bg-hover: #FFAA2B;
    --fab-icon: #00093F;
    --fab-badge-bg: #EF4444;
    --fab-badge-text: #ffffff;
    --fab-size: 58px;
    --fab-size-mobile: 52px;
    --fab-border: rgba(0, 9, 63, 0.92);
}

.cart-fab {
    /* Logical inset properties auto-adapt to the page's writing direction.
       On this RTL storefront, "inline-end" resolves to the LEFT edge,
       keeping the FAB clear of the bottom-right toast notifications used
       on the home/product/cart pages. Flip to `right` for an LTR build. */
    position: fixed !important;
    inset-block-end: 24px;
    inset-inline-start: 20px;

    width: var(--fab-size);
    height: var(--fab-size);
    border-radius: 50%;

    display: flex !important;
    align-items: center;
    justify-content: center;

    background: var(--fab-bg);
    color: var(--fab-icon);
    font-size: 1.4rem;
    text-decoration: none;
    cursor: pointer;

    border: 3px solid var(--fab-border);
    box-shadow: 0 0 0 1px rgba(255, 151, 0, 0.16), 0 10px 22px rgba(0, 9, 63, 0.22);
    z-index: 9500; /* deliberately high — must win over any page-level fixed
                       overlay (toast stacks, sticky bars, etc.) added later */

    /* Visible by default — NOT dependent on the .is-visible entrance class.
       is-visible only adds the little "pop in" animation; if that class
       is ever delayed or fails to attach, the button is still on screen. */
    opacity: 1;
    transform: translateY(0) scale(1);

    transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275),
                box-shadow 0.25s ease,
                background 0.25s ease;
    -webkit-tap-highlight-color: transparent;
}

.cart-fab i {
    pointer-events: none;
}

/* Hover / active interaction states */
.cart-fab:hover {
    background: var(--fab-bg-hover);
    transform: translateY(-4px) scale(1.05);
    box-shadow: 0 0 0 1px rgba(255, 151, 0, 0.22), 0 16px 32px rgba(0, 0, 0, 0.32);
}

.cart-fab:active {
    transform: translateY(-1px) scale(0.96);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.25);
}

.cart-fab:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(0, 9, 63, 0.35), 0 10px 24px rgba(0, 0, 0, 0.28);
}

/* Entrance animation so the FAB doesn't just "pop" on load */
@keyframes fabEnter {
    from { transform: translateY(16px) scale(0.7); opacity: 0; }
    to   { transform: translateY(0) scale(1); opacity: 1; }
}

.cart-fab.is-visible {
    animation: fabEnter 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
}

/* Badge counter */
.cart-fab-badge {
    position: absolute;
    top: -4px;
    inset-inline-end: -4px;

    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    border-radius: 11px;

    background: var(--fab-badge-bg);
    color: var(--fab-badge-text);
    border: 2px solid #fff;

    font-size: 0.72rem;
    font-weight: 800;
    font-family: 'Cairo', sans-serif;
    line-height: 1;

    display: flex;
    align-items: center;
    justify-content: center;

    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
}

.cart-fab-badge[hidden] {
    display: none;
}

/* Plays once each time the badge count updates */
@keyframes badgeBump {
    0%   { transform: scale(1); }
    35%  { transform: scale(1.35); }
    100% { transform: scale(1); }
}

.cart-fab-badge.bump {
    animation: badgeBump 0.35s ease;
}

@media (prefers-reduced-motion: reduce) {
    .cart-fab,
    .cart-fab-badge {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
    }
}

/* ==========================================================================
   MOBILE MEDIA QUERIES
   ========================================================================== */

@media (max-width: 768px) {
    .cart-fab {
        width: var(--fab-size-mobile);
        height: var(--fab-size-mobile);
        font-size: 1.25rem;
        inset-block-end: 18px;
        inset-inline-start: 14px;
    }

    .cart-fab-badge {
        min-width: 19px;
        height: 19px;
        font-size: 0.66rem;
        top: -3px;
    }
}

/* Keep the FAB clear of the mobile toast stack (top-left on the products
   page, bottom-right elsewhere) — no overlap adjustment needed by default,
   but nudge it up if a page adds a bottom nav/tab bar of its own. */
body.has-bottom-nav .cart-fab {
    inset-block-end: 84px;
}