@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap');

:root {
    --pw-primary-color: #00093f;      /* navy — selected states, quantity controls */
    --pw-primary-hover: #101757;
    --pw-cta: #ff9700;                /* brand orange — the "Add to cart" primary CTA */
    --pw-cta-hover: #e68600;
    --pw-bg: #ffffff;
    --pw-text: #111827;
    --pw-muted: #6b7280;
    --pw-border: #e5e7eb;
    --pw-radius: 16px;
    --pw-gap: 16px;
    --pw-accent: #ff9700;             /* was an off-brand gold (#FFC312) — aligned to the brand orange for stars/ratings */
    --page-bg: #F6F7FB;               /* clean light neutral page, not brand navy */
}
body {
    font-family: 'Cairo', sans-serif;
    background: var(--page-bg);
    margin: 0;
    padding: 0;
    color: var(--pw-text);
    direction: rtl;
}

.container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 15px;
}

/* =========================================
   بطاقة المنتج الأساسية (Widget)
========================================= */
#product-widget-container {
    max-width: 1000px;
    margin: 20px auto;
    padding: 0 15px;
}

.product-widget {
    background: var(--pw-bg);
    border-radius: var(--pw-radius);
    overflow: hidden;
    box-shadow: 0 6px 24px rgba(17, 24, 39, 0.08);
    border: 1px solid var(--pw-border);
}

.pw__inner {
    display: flex;
    flex-direction: column;
}

@media(min-width: 768px) {
    .pw__inner { flex-direction: row; }
}

/* صورة المنتج */
.pw__image-col {
    background: #f8f9fa;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
}

@media(min-width: 768px) {
    .pw__image-col { flex-basis: 45%; max-width: 45%; }
}

.pw__image-trigger {
    width: 100%;
    aspect-ratio: 1/1; /* لجعل الصورة مربعة ومضبوطة دائماً */
    position: relative;
    border-radius: 12px;
    overflow: hidden;
}

.pw__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
}

/* تفاصيل المنتج */
.pw__details {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: var(--pw-gap);
    flex: 1;
}

.pw__title {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0;
    color: var(--pw-text);
    line-height: 1.3;
}

/* السعر */
#pw-price {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
}

.new-price {
    font-size: 1.6rem;
    font-weight: 800;
    color: #e74c3c;
}

.old-price {
    font-size: 1rem;
    text-decoration: line-through;
    color: var(--pw-muted);
}

.usd-price {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--pw-muted);
}

.discount-badge {
    background: #fee2e2;
    color: #dc2626;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
}

.pw__description {
    color: var(--pw-muted);
    font-size: 1rem;
    line-height: 1.6;
}

/* =========================================
   أدوات التحكم (المقاس، اللون، الكمية)
========================================= */
.pw__controls {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 10px;
}

.pw__control-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.pw__label {
    font-size: 0.95rem;
    font-weight: 700;
}

/* اختيار الألوان */
.pw__color-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.pw__color-swatch {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--pw-border);
    cursor: pointer;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.pw__color-swatch.selected {
    border-color: var(--pw-primary-color);
    transform: scale(1.1);
    box-shadow: 0 0 0 2px var(--pw-primary-color);
}

/* اختيار المقاس */
.pw__select {
    padding: 14px;
    border: 1px solid var(--pw-border);
    border-radius: 10px;
    font-family: inherit;
    font-size: 1rem;
    background: var(--pw-bg);
}

/* الكمية (مخصصة للموبايل لتكون كبيرة وسهلة اللمس) */
.pw__qty {
    display: flex;
    align-items: center;
    background: #f8f9fa;
    border: 1px solid var(--pw-border);
    border-radius: 12px;
    width: fit-content;
    overflow: hidden;
}

.pw__qty-btn {
    width: 48px;
    height: 48px;
    background: transparent;
    border: none;
    font-size: 1.5rem;
    color: var(--pw-text);
    cursor: pointer;
}

.pw__qty-input {
    width: 60px;
    height: 48px;
    border: none;
    background: transparent;
    text-align: center;
    font-size: 1.1rem;
    font-weight: 700;
}

/* زر الإضافة للسلة */
.pw__add-btn {
    width: 100%;
    padding: 16px;
    background: var(--pw-cta);
    color: var(--pw-primary-color);
    border: none;
    border-radius: 12px;
    font-size: 1.1rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(255, 151, 0, 0.3);
    transition: background 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
}

.pw__add-btn:hover {
    background: var(--pw-cta-hover);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(230, 134, 0, 0.35);
}

/* =========================================
   التقييمات (Reviews)
========================================= */
.section-title {
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 20px;
    color: var(--pw-text);
}

.reviews-layout {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

@media(min-width: 768px) {
    .reviews-layout { flex-direction: row; }
    .product-reviews-box { flex: 2; }
    .review-form { flex: 1; }
}

.review-form, .product-reviews-box {
    background: var(--pw-bg);
    padding: 20px;
    border-radius: var(--pw-radius);
    border: 1px solid var(--pw-border);
    box-shadow: 0 4px 16px rgba(17, 24, 39, 0.05);
}

.form-group label {
    font-weight: 700;
    display: block;
    margin-bottom: 8px;
}

.form-textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--pw-border);
    border-radius: 10px;
    font-family: inherit;
    box-sizing: border-box; /* لمنع الخروج عن الحواف */
}

/* النجوم */
.rating-input {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 4px;
}

.rating-input .star {
    font-size: 2rem;
    color: #d1d5db;
    cursor: pointer;
    transition: color 0.2s ease;
}

/* عند التأشير أو الاختيار، تضيء النجمة الحالية وكل النجوم التي قبلها */
.rating-input .star:hover,
.rating-input .star:hover ~ .star,
.rating-input .star.selected,
.rating-input .star.selected ~ .star {
    color: var(--pw-accent) !important;
}

.review-item {
    border-bottom: 1px solid var(--pw-border);
    padding: 15px 0;
}
.review-item:last-child { border: none; }

.review-stars { color: var(--pw-accent); font-size: 1.1rem; }
.review-comment { margin-top: 8px; font-size: 0.95rem; line-height: 1.6; }

/* =========================================
   منتجات ذات صلة
========================================= */
.related-products-list {
    display: flex;
    gap: 15px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 15px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
}
.related-products-list::-webkit-scrollbar { display: none; }

.product-card {
    min-width: 160px;
    background: var(--pw-bg);
    border: 1px solid var(--pw-border);
    border-radius: 12px;
    padding: 10px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
}

.product-card-image {
    width: 100%;
    height: 140px;
    object-fit: contain;
    border-radius: 8px;
    margin-bottom: 10px;
}
#toast-box {
    position: fixed;
    top: 30px;
    left: 30px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    z-index: 9999;
}

.toast {
    width: 350px;
    height: 70px;
    background: #fff;
    font-weight: 600;
    margin: 10px 0;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    position: relative;
    transform: translateX(-100%);
    animation: slideIn 0.5s forwards;
    border-radius: 8px;
    overflow: hidden;
    font-family: 'Cairo', sans-serif;
}

.toast i { font-size: 24px; margin: 0 15px; }
.toast.success { border-right: 6px solid #2ecc71; }
.toast.success i { color: #2ecc71; }
.toast.error { border-right: 6px solid #e74c3c; }
.toast.error i { color: #e74c3c; }
.toast.warning { border-right: 6px solid var(--pw-accent); }
.toast.warning i { color: var(--pw-accent); }

.toast::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: rgba(0, 0, 0, 0.05);
    animation: timeOut 4s linear forwards;
}

.toast.hide { animation: slideOut 0.5s forwards; }

@keyframes slideIn { 100% { transform: translateX(0); } }
@keyframes timeOut { 100% { width: 0; } }
@keyframes slideOut { 0% { transform: translateX(0); } 100% { transform: translateX(-200%); opacity: 0; } }

/* ===== Responsive: تكييف الإشعارات على الموبايل (نفس أسلوب MyOrders) ===== */
@media (max-width: 768px) {
    #toast-box { top: 12px; left: 12px; right: 12px; }
    .toast { width: calc(100vw - 32px); max-width: 320px; height: auto; min-height: 60px; padding: 10px 14px; font-size: 0.82rem; }
}

@media (max-width: 480px) {
    #toast-box { top: 12px; left: 12px; right: 12px; }
    .toast { width: 100%; max-width: none; }
}
/* =========================================
   موبايل استثنائي (Edge to edge)
========================================= */
@media (max-width: 768px) {
    #product-widget-container {
        padding: 0; /* إزالة الحواف في الموبايل */
        margin-top: 0;
    }
    .product-widget {
        border-radius: 0;
        border-left: none;
        border-right: none;
        box-shadow: none;
        border-top: none;
    }
    .pw__qty {
        width: 100%; /* زر الكمية يأخذ العرض كامل */
        justify-content: space-between;
    }
}